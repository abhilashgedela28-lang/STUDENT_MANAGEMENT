# Server Port (Render, Railway, etc. automatically bind $PORT)
PORT=5000

# MongoDB Connection String (Atlas URI or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codetrack?retryWrites=true&w=majority

# JWT Secret for Session Auth (Use a secure random string: e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Account Seeding (seeded on first boot if no admin exists)
ADMIN_EMAIL=admin@codetrack.dev
ADMIN_PASSWORD=your_admin_secure_password

# Node Environment ('production' or 'development')
NODE_ENV=production

# Application Rate Limiting & Cooldowns
SYNC_COOLDOWN_SECONDS=45
SYNC_DAILY_CAP=50
SNAPSHOT_CRON="0 2 * * *"

# Optional: Allowed CORS Origins (comma-separated, e.g. https://your-client.vercel.app)
# If omitted or left blank, reflects the request origin
# ALLOWED_ORIGINS=https://your-client.vercel.app

# Optional: Test Verification Bypass (leave false in production to enforce real platform profile checks)
ALLOW_TEST_VERIFY=false

# Optional: Frontend API Base URL (only needed if frontend is hosted on a different domain than backend)
# VITE_API_BASE_URL=https://api.yourdomain.com/api
